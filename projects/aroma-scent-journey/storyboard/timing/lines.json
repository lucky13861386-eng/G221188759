[
 {
  "line": 1,
  "text": "為什麼很多人聞到某些味道，會覺得比較容易放鬆下來？",
  "start": 0.0,
  "end": 3.0
 },
 {
  "line": 2,
  "text": "小孩睡了、碗也洗完了",
  "start": 3.0,
  "end": 5.5
 },
 {
  "line": 3,
  "text": "你終於坐下來",
  "start": 5.5,
  "end": 8.0
 },
 {
  "line": 4,
  "text": "卻還是放鬆不下來？",
  "start": 8.0,
  "end": 10.5
 },
 {
  "line": 5,
  "text": "其實有一個很快的方法",
  "start": 10.5,
  "end": 13.0
 },
 {
  "line": 6,
  "text": "就是用你的鼻子",
  "start": 13.0,
  "end": 15.5
 },
 {
  "line": 7,
  "text": "我們的眼睛、耳朵、皮膚接收到的訊號",
  "start": 15.5,
  "end": 18.5
 },
 {
  "line": 8,
  "text": "大多要先經過大腦裡，一個叫「視丘」的轉運站",
  "start": 18.5,
  "end": 21.5
 },
 {
  "line": 9,
  "text": "再分送出去",
  "start": 21.5,
  "end": 24.0
 },
 {
  "line": 10,
  "text": "但嗅覺不一樣",
  "start": 24.0,
  "end": 26.5
 },
 {
  "line": 11,
  "text": "氣味分子進到鼻子以後",
  "start": 26.5,
  "end": 29.0
 },
 {
  "line": 12,
  "text": "主要的訊號不用先經過視丘",
  "start": 29.0,
  "end": 32.0
 },
 {
  "line": 13,
  "text": "可以直接傳到大腦裡，管情緒和記憶的地方",
  "start": 32.0,
  "end": 35.0
 },
 {
  "line": 14,
  "text": "也就是「邊緣系統」",
  "start": 35.0,
  "end": 37.5
 },
 {
  "line": 15,
  "text": "所以你才會在聞到某個味道的時候",
  "start": 37.5,
  "end": 40.5
 },
 {
  "line": 16,
  "text": "一瞬間想起外婆家",
  "start": 40.5,
  "end": 43.0
 },
 {
  "line": 17,
  "text": "或是某個很安心的午後",
  "start": 43.0,
  "end": 45.5
 },
 {
  "line": 18,
  "text": "這也是為什麼香氣可以幫你營造放鬆的氛圍",
  "start": 45.5,
  "end": 48.5
 },
 {
  "line": 19,
  "text": "成為照顧自己的小儀式",
  "start": 48.5,
  "end": 51.0
 },
 {
  "line": 20,
  "text": "不過要提醒你",
  "start": 51.0,
  "end": 53.5
 },
 {
  "line": 21,
  "text": "精油要稀釋過才能接觸皮膚，也不要直接吞",
  "start": 53.5,
  "end": 56.5
 },
 {
  "line": 22,
  "text": "家裡有孕婦、小嬰兒或毛小孩的話",
  "start": 56.5,
  "end": 59.5
 },
 {
  "line": 23,
  "text": "選擇和使用方式要更小心",
  "start": 59.5,
  "end": 62.0
 }
]